package components

templ RoleDropdown(currentRole string, roles []string) {
	<select
		name="role"
		class="rounded border border-[#D7D7D7] bg-white px-2 py-1 text-[12px] text-[#2C2F35]"
		hx-post="/auth/role/switch"
		hx-trigger="change"
		hx-target="body"
		hx-swap="outerHTML"
		hx-indicator="#role-spinner"
	>
		for _, r := range roles {
			if r == currentRole {
				<option value={ r } selected>{ r }</option>
			} else {
				<option value={ r }>{ r }</option>
			}
		}
	</select>
	<span id="role-spinner" class="htmx-indicator ml-1 text-[10px] text-white">...</span>
}
