package home

import (
	"strconv"
	"github.com/konsulin-care/konsulin-app/internal/service"
)

templ AdminPage(data *service.HomeData) {
	<!-- Operational Overview -->
	<div class="p-4">
		<div class="mb-2 text-[14px] font-bold text-muted">
			Clinic Overview
		</div>
		<div class="flex gap-4">
			<div class="flex flex-1 flex-col items-center rounded-lg bg-[#F9F9F9] p-4">
				<span class="text-[20px] font-bold text-[#08979C]">{ strconv.Itoa(data.PractitionerCount) }</span>
				<span class="text-[10px] text-[#2C2F3599]">Practitioners</span>
			</div>
			<div class="flex flex-1 flex-col items-center rounded-lg bg-[#F9F9F9] p-4">
				<span class="text-[20px] font-bold text-[#FF6B6B]">{ strconv.Itoa(data.PendingApprovals) }</span>
				<span class="text-[10px] text-[#2C2F3599]">Pending Approvals</span>
			</div>
		</div>
	</div>

	<!-- Clinic Context Switcher -->
	if len(data.Clinics) > 0 {
		<div class="px-4 pb-4">
			<div class="mb-2 text-[14px] font-bold text-muted">
				Select Clinic
			</div>
			<select class="w-full rounded-lg border border-[#D7D7D7] bg-white p-3 text-[12px] text-[#2C2F35]">
				for _, clinic := range data.Clinics {
					<option value={ clinic.ID }>{ clinic.Name }</option>
				}
			</select>
		</div>
	}

	<!-- Service Management Links -->
	<div class="px-4 pb-4">
		<div class="mb-2 text-[14px] font-bold text-muted">
			Management
		</div>
		<div class="flex flex-col gap-2">
			<a href="/practitioner" class="rounded-lg bg-[#F9F9F9] p-4 text-[12px] font-semibold text-[#2C2F35]">
				Manage Practitioners
			</a>
			<a href="/clinic" class="rounded-lg bg-[#F9F9F9] p-4 text-[12px] font-semibold text-[#2C2F35]">
				Clinic Settings
			</a>
		</div>
	</div>
}
