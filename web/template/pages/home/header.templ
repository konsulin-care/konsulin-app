package home

import (
	"github.com/konsulin-care/konsulin-app/internal/service"
)

templ Header(data *service.HomeData) {
	if data.IsGuest {
		<div class="flex flex-col">
			<div class="flex h-[32px] items-center text-[14px] font-bold text-white">
				Konsulin
			</div>
		</div>
	} else {
		<div class="flex w-full flex-col justify-center">
			<div class="flex">
				<div class="mr-2 flex h-[32px] w-[32px] items-center justify-center rounded-full bg-white text-xs font-bold text-[#08979C]">
					{ avatarPlaceholder(data.DisplayName) }
				</div>
				<div class="flex h-[32px] flex-col">
					<div class="text-[10px] font-normal text-white">
						Welcome to Your Dashboard
					</div>
					<div class="text-[14px] font-bold text-white">
						{ data.DisplayName }
					</div>
				</div>
			</div>
			if data.UpcomingSession != nil {
				<div class="mt-2 rounded-lg bg-white/20 p-3">
					<div class="flex items-center">
						<img src="/static/icons/calendar.svg" width="32" height="32" alt="calendar"/>
						<div class="ml-2 mr-auto flex flex-col">
							<span class="text-[12px] text-white/80">Upcoming Session With</span>
							<span class="text-[14px] font-bold text-white">{ data.UpcomingSession.DisplayName }</span>
						</div>
						<div>
							<span class="text-[12px] font-bold text-white">{ data.UpcomingSession.Time }</span>
							<span class="text-[12px] text-white/80"> | { data.UpcomingSession.Date }</span>
						</div>
					</div>
				</div>
			}
		</div>
	}
}

func avatarPlaceholder(name string) string {
	if len(name) == 0 {
		return "?"
	}
	runes := []rune(name)
	return string(runes[0])
}
